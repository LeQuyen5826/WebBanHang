@model Category
@{
    ViewData["Title"] = "Sửa danh mục";
}
<h2>Sửa danh mục</h2>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />
    <label asp-for="Name">Tên danh mục</label>
    <input asp-for="Name" />
    <span asp-validation-for="Name" class="error"></span>
    <p><button>Lưu</button> <a asp-action="Index">Quay lại</a></p>
</form>
