@model IEnumerable<Order>
@{
    ViewData["Title"] = "Đơn hàng";
}
<h2>Đơn hàng</h2>
<a class="btn" asp-action="Create">Tạo đơn hàng</a>
<table>
    <tr><th>Mã</th><th>Khách hàng</th><th>Ngày</th><th>Tổng tiền</th><th></th></tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.CustomerName</td>
            <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@item.CalculateTotal().ToString("N0")</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline" onsubmit="return confirm('Xóa đơn hàng này?')">
                    <button class="danger">Xóa</button>
                </form>
            </td>
        </tr>
    }
</table>
