@model Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}
<h2>Đơn hàng #@Model.Id</h2>
<p>Khách hàng: <strong>@Model.CustomerName</strong> - Ngày: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
<table>
    <tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr>
    @foreach (var i in Model.Items)
    {
        <tr>
            <td>@i.Product?.Name</td>
            <td>@i.Price.ToString("N0")</td>
            <td>@i.Quantity</td>
            <td>@((i.Price * i.Quantity).ToString("N0"))</td>
        </tr>
    }
</table>
<h3>Tổng tiền: @Model.CalculateTotal().ToString("N0")</h3>
<a asp-action="Index">Quay lại</a>
