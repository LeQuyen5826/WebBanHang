@model IEnumerable<Product>
@{
    ViewData["Title"] = "Sản phẩm";
}
<h2>Sản phẩm</h2>
<a class="btn" asp-action="Create">Thêm sản phẩm</a>
<table>
    <tr><th>Tên</th><th>Danh mục</th><th>Giá</th><th></th></tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Category?.Name</td>
            <td>@item.Price.ToString("N0")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline" onsubmit="return confirm('Xóa sản phẩm này?')">
                    <button class="danger">Xóa</button>
                </form>
            </td>
        </tr>
    }
</table>
